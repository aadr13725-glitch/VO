class TooBig(Exception):
    pass


IMG_EXT = {"jpg", "jpeg", "png", "webp"}
AUD_EXT = {"mp3", "m4a", "aac", "ogg", "opus", "wav"}


def _find_file(outdir):
    files = [os.path.join(outdir, f) for f in os.listdir(outdir)
             if not f.endswith((".part", ".ytdl", ".json", ".temp"))]
    return max(files, key=os.path.getsize) if files else None


def _video_candidates(info, limit):
    """يختار صيغ جاهزة (فيديو+صوت معاً) بدون علامة مائية وبحجم مناسب، من الأفضل للأقل."""
    fmts = info.get("formats") or []
    bad = set("/+[]()")

    def size(f): return f.get("filesize") or f.get("filesize_approx")

    def watermarked(f):
        s = ((f.get("format_note") or "") + " " + str(f.get("format_id") or "")).lower()
        return "watermark" in s or str(f.get("format_id")) == "download"

    prog = [f for f in fmts if f.get("format_id") and f.get("vcodec") != "none" and f.get("acodec") != "none"
            and not (set(str(f["format_id"])) & bad)]
    clean = [f for f in prog if not watermarked(f)] or prog
    ok = [f for f in clean if not size(f) or size(f) <= limit]
    ok.sort(key=lambda f: (f.get("height") or 0, f.get("tbr") or 0), reverse=True)
    ids = [str(f["format_id"]) for f in ok[:3]]
    if ids: return ids
    if not prog and HAS_FFMPEG: return ["bv*[height<=720]+ba/b"]
    return ["b/best"]


def dl_sync(url, outdir, audio, limit):
    opts = {"outtmpl": os.path.join(outdir, "%(extractor)s_%(id)s.%(ext)s"), "quiet": True, "no_warnings": True,
            "noplaylist": True, "playlist_items": "1", "socket_timeout": 30, "retries": 3,
            "restrictfilenames": True, "max_filesize": limit}
    if os.path.exists(COOKIES): opts["cookiefile"] = COOKIES

    info, last_ex = None, None
    for _ in range(3):                      # تيك توك يفشل أحياناً عشوائياً، نعيد المحاولة
        try:
            with yt_dlp.YoutubeDL({**opts, "skip_download": True}) as y:
                info = y.extract_info(url, download=False)
            break
        except yt_dlp.utils.DownloadError as e:
            last_ex = e
            time.sleep(1.5)
    if info is None:
        raise last_ex
    if info.get("_type") == "playlist":
        entries = [e for e in (info.get("entries") or []) if e]
        if not entries: raise RuntimeError("no media found")
        info = entries[0]

    if audio:
        if HAS_FFMPEG:
            attempts = [("bestaudio/best", {"postprocessors": [
                {"key": "FFmpegExtractAudio", "preferredcodec": "mp3", "preferredquality": "192"}]})]
        else:
            attempts = [("bestaudio[ext=m4a]/bestaudio/best", {})]
    else:
        attempts = [(f, {}) for f in _video_candidates(info, limit)]

    last_err, skipped = None, False
    for fmt, extra in attempts:
        for f in os.listdir(outdir):
            try: os.remove(os.path.join(outdir, f))
            except OSError: pass
        failed = False
        try:
            with yt_dlp.YoutubeDL({**opts, "format": fmt, **extra}) as y:
                try:
                    # نستخدم المعلومات المستخرجة سابقاً دون إعادة جلب الصفحة (تفادي خطأ تيك توك)
                    y.process_ie_result(y.sanitize_info(info), download=True)
                except yt_dlp.utils.DownloadError:
                    raise
                except Exception:
                    y.download([url])
        except yt_dlp.utils.DownloadError as e:
            last_err = e
            failed = True
        path = _find_file(outdir)       # حتى لو حصل خطأ بعد التنزيل نستفيد من الملف إن اكتمل
        if not path and failed:
            continue
        if path and os.path.getsize(path) <= limit:
            ext = path.rsplit(".", 1)[-1].lower()
            kind = "photo" if ext in IMG_EXT else "audio" if ext in AUD_EXT else "video"
            return {"path": path, "kind": kind, "title": info.get("title") or "video",
                    "duration": info.get("duration"), "width": info.get("width"), "height": info.get("height"),
                    "size": os.path.getsize(path)}
        skipped = True
    if skipped: raise TooBig()
    raise last_err or RuntimeError("download failed")


