def _fetch_file(u, path, limit):
    import urllib.request
    if u.startswith("/"): u = "https://www.tikwm.com" + u
    req = urllib.request.Request(u, headers={"User-Agent": UA})
    total = 0
    with urllib.request.urlopen(req, timeout=60) as r, open(path, "wb") as f:
        while True:
            chunk = r.read(1 << 16)
            if not chunk: break
            total += len(chunk)
            if total > limit: raise TooBig()
            f.write(chunk)
    return total


def tiktok_fallback(url, outdir, audio, limit):
    """مسار بديل لتيك توك عبر خدمة tikwm (بدون علامة مائية) عند فشل yt-dlp."""
    import json, urllib.request, urllib.parse
    api = "https://www.tikwm.com/api/?hd=1&url=" + urllib.parse.quote(url, safe="")
    req = urllib.request.Request(api, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=30) as r:
        data = json.loads(r.read().decode("utf-8", "ignore"))
    d = data.get("data") or {}
    if data.get("code") != 0 or not d:
        raise RuntimeError(f"tikwm: {data.get('msg')}")
    for f in os.listdir(outdir):
        try: os.remove(os.path.join(outdir, f))
        except OSError: pass
    title = d.get("title") or "TikTok"
    if audio:
        sources = [(d.get("music"), "mp3", "audio")]
    else:
        sources = [(d.get("hdplay"), "mp4", "video"), (d.get("play"), "mp4", "video")]
    sources = [x for x in sources if x[0]]
    if not sources:
        raise RuntimeError("tikwm: no media (maybe photo post)")
    too_big = False
    for src, ext, kind in sources:
        path = os.path.join(outdir, f"tiktok_{d.get('id', 'video')}.{ext}")
        try:
            size = _fetch_file(src, path, limit)
        except TooBig:
            too_big = True
            continue
        return {"path": path, "kind": kind, "title": title, "duration": d.get("duration"),
                "width": None, "height": None, "size": size}
    if too_big: raise TooBig()
    raise RuntimeError("tikwm failed")


def dl_any(url, outdir, audio, limit):
    try:
        return dl_sync(url, outdir, audio, limit)
    except TooBig:
        raise
    except Exception as e:
        if detect(url) != "tiktok":
            raise
        log.warning("yt-dlp فشل مع تيك توك، أجرّب المسار البديل: %s", str(e)[:120])
        try:
            return tiktok_fallback(url, outdir, audio, limit)
        except TooBig:
            raise
        except Exception as e2:
            raise RuntimeError(f"yt-dlp: {str(e)[:150]} | fallback: {str(e2)[:150]}")


