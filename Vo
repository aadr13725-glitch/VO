        res = ("⚠️ Error", True)
    text, alert = res if isinstance(res, tuple) else (None, False)
    await safe_answer(q, text, alert)


async def handle_cb(q, context, uid, act, arg):
    bot, user = context.bot, q.from_user
    botname = bot.username

    if act == "noop": return
    if act == "chk":
        if await missing_channels(bot, uid):
            return (tr(uid, "not_yet"), True)
        try: await q.message.delete()
        except TelegramError: pass
        text, parse, kb = welcome_payload(user, botname)
        return await bot.send_message(uid, text, parse_mode=parse, reply_markup=kb)

    if act == "home":
        text, parse, kb = welcome_payload(user, botname)
        return await show(q, context, text, kb, parse)

    if act == "pf":
        names = T[get_lang(uid)]["plat"]
        text = tr(uid, "tip_any") if arg == "any" else tr(uid, "tip", p=names.get(arg, arg))
        return await show(q, context, text, IM([[IB(tr(uid, "b_back"), callback_data="home")]]))

    if act == "help":
        return await show(q, context, tr(uid, "help"),
                          IM([[IB(tr(uid, "b_back"), callback_data="home")]]))

    if act == "me":
        total = one("SELECT COUNT(*) c FROM dl_log WHERE uid=? AND ok=1", (uid,))["c"]
        lim = daily_limit()
        u = one("SELECT joined FROM users WHERE id=?", (uid,))
        text = tr(uid, "stats_me", total=total, today=today_count(uid), limit=lim if lim else "∞",
                  joined=(u["joined"][:10] if u else "-"))
        return await show(q, context, text, IM([[IB(tr(uid, "b_back"), callback_data="home")]]))

    if act == "lang":
        kb = IM([[IB("🇮🇶 العربية", callback_data="setlang:ar"), IB("🇬🇧 English", callback_data="setlang:en")]])
        return await show(q, context, tr(uid, "choose_lang"), kb)

    if act == "setlang":
        if arg in ("ar", "en"): run("UPDATE users SET lang=? WHERE id=?", (arg, uid))
        text, parse, kb = welcome_payload(user, botname)
        await show(q, context, text, kb, parse)
        return (tr(uid, "lang_set"), False)

    if act == "rep":
        context.user_data["state"] = ("report", None)
        return await bot.send_message(uid, tr(uid, "report_prompt"))

    if act == "aud":
        url = context.bot_data.get("links", {}).get(arg)
        if not url: return ("⌛ انتهت صلاحية الزر، أرسل الرابط مجدداً", True)
        await safe_answer(q, "🎵 ...")
        return await process_link(context, user, q.message.chat_id, q.message.message_id, url, audio=True)

    if act == "a":
        if not is_admin(uid): return ("⛔", True)
        sub, _, rest = arg.partition(":")
        return await handle_admin_cb(q, context, uid, sub, rest)


# ---------------- الرسائل الخاصة ----------------
async def handle_state(update, context):
    m, uid = update.message, update.message.from_user.id
    text = (m.text or "").strip()
    kind, ref = context.user_data["state"]
    adm = is_admin(uid)
    if kind != "report" and not adm:
        context.user_data.pop("state", None)
        return False
    if kind == "admin_add" and not is_owner(uid):
        context.user_data.pop("state", None)
        return False
    done = lambda: context.user_data.pop("state", None)

    if kind == "report":
        done()
        kb = IM([[IB("✉️ رد", callback_data=f"a:reply:{uid}"), IB("🚫 حظر", callback_data=f"a:banq:{uid}")]])
        head = f"🆘 بلاغ من <b>{esc(m.from_user.full_name)}</b> (<code>{uid}</code>)"
        for a in admin_ids():
            try:
                if m.text:
                    await context.bot.send_message(a, f"{head}\n\n{esc(text[:800])}", parse_mode=HTML, reply_markup=kb)
                else:
                    await context.bot.send_message(a, head, parse_mode=HTML)
                    await context.bot.copy_message(a, m.chat_id, m.message_id, reply_markup=kb)
            except TelegramError:
                pass
        await m.reply_text(tr(uid, "report_sent"))
        return True

    if kind in ("bc", "bc_fwd", "bc_quick"):
        done()
        mode = "forward" if kind == "bc_fwd" else "copy"
        if kind == "bc_quick":
            await m.reply_text("⚡ بدأت الإذاعة السريعة، سأخبرك عند الانتهاء.")
            context.application.create_task(broadcast(context.bot, uid, m.chat_id, m.message_id, mode))
            return True
        context.user_data["bc_pending"] = (m.chat_id, m.message_id, mode)
        n = one("SELECT COUNT(*) c FROM users WHERE banned=0 AND blocked=0")["c"]
        kb = IM([[IB(f"✅ إرسال لـ {n:,}", callback_data="a:bcgo"), IB("❌ إلغاء", callback_data="a:bcno")]])
        await m.reply_text("👆 هذه الرسالة ستُرسل لكل المستخدمين. تأكيد؟", reply_markup=kb,
                           reply_parameters=ReplyParameters(message_id=m.message_id))
        return True

    if kind == "admin_add":
        if not text.isdigit():
            await m.reply_text("⚠️ أرسل معرّفاً رقمياً صحيحاً.")
            return True
        target = int(text)
        if target == OWNER_ID or is_admin(target):
            await m.reply_text("ℹ️ هذا المستخدم لديه صلاحية مشرف بالفعل.")
            done()
            return True
        run("INSERT OR IGNORE INTO admins(id,added_by) VALUES(?,?)", (target, uid))
        await refresh_private_commands(context.bot, target)
        done()
        await m.reply_text(f"✅ تمت إضافة <code>{target}</code> إلى المشرفين.", parse_mode=HTML)
        return True

    if kind == "cookies":
        if not m.document:
            await m.reply_text("⚠️ أرسل الملف كمستند، أو /cancel.")
            return True
        if (m.document.file_size or 0) > 3_000_000:
            await m.reply_text("⚠️ الملف كبير جداً.")
            return True
        f = await context.bot.get_file(m.document.file_id)
        await f.download_to_drive(COOKIES)
        try:
            os.chmod(COOKIES, 0o600)
        except OSError:
            pass
        done()
        await m.reply_text("✅ تم حفظ cookies.txt وسيُستخدم تلقائياً.")
        return True

    if not text:
        await m.reply_text("⚠️ أرسل نصاً من فضلك (أو /cancel).")
        return True

    if kind in ("ban_id", "unban_id"):
        if not text.isdigit():
            await m.reply_text("⚠️ أرسل رقم ID صحيح.")
            return True
        target, ban = int(text), kind == "ban_id"
        if ban and is_admin(target):
            await m.reply_text("⛔ لا يمكن حظر مشرف.")
            done()
            return True
        run("UPDATE users SET banned=? WHERE id=?", (1 if ban else 0, target))
        done()
        await m.reply_text("🚫 تم الحظر" if ban else "♻️ تم فك الحظر")
        if flag("ban_notify", "1"):
            try:
                await context.bot.send_message(target, tr(target, "banned") if ban else "✅ تم فك الحظر عنك.")
            except TelegramError:
                pass
    elif kind == "add_ch":
        if len(channel_list()) >= MAX_CH:
            await m.reply_text(f"⚠️ وصلت للحد الأقصى ({MAX_CH} قنوات).")
            done()
            return True
        ch = text.replace("https://t.me/", "").replace("t.me/", "").strip().lstrip("@")
        ch = "@" + ch
        try:
            me = await context.bot.get_chat_member(ch, context.bot.id)
            if me.status not in ("administrator", "creator"):
                await m.reply_text("⚠️ البوت ليس مشرفاً في هذه القناة. اجعله مشرفاً ثم أعد المحاولة.")
                return True
        except TelegramError as e:
            await m.reply_text(f"⚠️ تعذّر الوصول للقناة: {e}")
            return True
        run("INSERT OR IGNORE INTO channels(name) VALUES(?)", (ch,))
        done()
        await m.reply_text(f"✅ تمت إضافة {ch}")
    elif kind == "set_limit":
        if not text.isdigit():
            await m.reply_text("⚠️ أرسل رقماً.")
            return True
        set_S("daily_limit", text); done()
        await m.reply_text("✅ تم الحفظ")
    elif kind == "set_welcome":
        set_S("welcome", text[:1500]); done()
        await m.reply_text("✅ تم حفظ رسالة الترحيب")
    elif kind == "set_sub_msg":
        set_S("sub_msg", "" if text == "-" else text[:1000]); done()
        await m.reply_text("✅ تم الحفظ" if text != "-" else "↩️ رجعت للنص الافتراضي")
    elif kind == "find_user":
        if not text.isdigit():
            await m.reply_text("⚠️ أرسل رقم ID صحيح.")
            return True
        u = one("SELECT * FROM users WHERE id=?", (int(text),))
        done()
        if not u:
            await m.reply_text("❌ المستخدم غير موجود")
            return True
        total = one("SELECT COUNT(*) c FROM dl_log WHERE uid=? AND ok=1", (u["id"],))["c"]
        kb = IM([[IB("✉️ رد", callback_data=f"a:reply:{u['id']}"),
                  IB("♻️ فك الحظر" if u["banned"] else "🚫 حظر",
                     callback_data=f"a:{'unbanq' if u['banned'] else 'banq'}:{u['id']}")]])
        await m.reply_text(
            f"👤 <b>{esc(u['name'] or '-')}</b>\n🆔 <code>{u['id']}</code>\n📆 انضم: {(u['joined'] or '')[:10]}\n"
            f"📥 تحميلات ناجحة: {total}\n🚫 محظور: {'نعم' if u['banned'] else 'لا'}\n"
            f"🧱 حاظر البوت: {'نعم' if u['blocked'] else 'لا'}", parse_mode=HTML, reply_markup=kb)
    elif kind == "reply":
        done()
        try:
            await context.bot.send_message(ref, f"{tr(ref, 'from_admin')}\n\n{esc(text)}", parse_mode=HTML)
            await m.reply_text("✅ تم الإرسال")
        except Forbidden:
            run("UPDATE users SET blocked=1 WHERE id=?", (ref,))
            await m.reply_text("⚠️ هذا المستخدم حظر البوت، لا يمكن إرسال رد له.")
        except TelegramError:
            await m.reply_text("⚠️ فشل الإرسال")
    else:
        done()
        return False
    return True


@timed
async def on_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    m = update.message
    if not m or not m.from_user: return
    user = m.from_user
    uid = user.id
    if is_banned(uid): return
    if register_user(user) and flag("join_notify", "1"):
        context.application.create_task(notify_admins(
            context.bot, f"🆕 مستخدم جديد: <b>{esc(user.full_name)}</b> (<code>{uid}</code>)", parse_mode=HTML))

    if context.user_data.get("state") and await handle_state(update, context):
        return
    if not is_admin(uid) and flag("show_msgs", "1"):
        context.application.create_task(forward_to_admins(context.bot, m, user))
    if flag("maintenance") and not is_admin(uid):
        return await m.reply_text(tr(uid, "maint"))
    miss = await missing_channels(context.bot, uid)
    if miss: return await send_sub_prompt(context.bot, m.chat_id, uid, miss)

    urls = urls_from_message(m)
    if urls:
        return await process_link(context, user, m.chat_id, m.message_id, urls[0])
    await m.reply_text(tr(uid, "no_link"))


# ---------------- المجموعات ----------------
async def on_group_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """اكتشاف روابط المنصات المعروفة داخل المجموعات وتحميلها تلقائياً."""
    m = update.message
    if not m or not m.from_user or m.from_user.is_bot: return
    if not flag("grp_detect", "1"): return
    urls = [u for u in urls_from_message(m) if detect(u) != "other"]
    if not urls: return
    user = m.from_user
    if is_banned(user.id): return
    register_user(user)
    if await missing_channels(context.bot, user.id): return        # لا نزعج المجموعة ببوابة الاشتراك
    await process_link(context, user, m.chat_id, m.message_id, urls[0])


async def daily_report_loop(app):
    while True:
        now = datetime.now(timezone.utc)
        nxt = now.replace(hour=20, minute=55, second=0, microsecond=0)   # قبل منتصف الليل بتوقيت العراق
        if nxt <= now: nxt += timedelta(days=1)
        await asyncio.sleep((nxt - now).total_seconds())
        try:
            if flag("daily_report", "1"):
                await notify_admins(app.bot, "🗓 <b>التقرير اليومي</b>\n\n" + stats_text(), parse_mode=HTML)
        except Exception:
            log.exception("daily report failed")


