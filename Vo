def main_kb(uid, botname):
    names = T[get_lang(uid)]["plat"]
    kb, row = [], []
    for k in PLATS:
        if not flag(f"plat_{k}", "1"): continue
        row.append(IB(f"{PLAT_ICON[k]} {names[k]}", callback_data=f"pf:{k}"))
        if len(row) == 2:
            kb.append(row)
            row = []
    if row: kb.append(row)
    if flag("plat_other", "1"):
        kb.append([IB(tr(uid, "b_any"), callback_data="pf:any")])
    kb.append([IB(tr(uid, "b_stats"), callback_data="me"),
               IB(tr(uid, "b_help"), callback_data="help")])
    kb.append([IB(tr(uid, "b_report"), callback_data="rep"), IB(tr(uid, "b_lang"), callback_data="lang")])
    if botname:
        kb.append([IB(tr(uid, "b_group"), url=f"https://t.me/{botname}?startgroup=true")])
    return IM(kb)


def welcome_payload(user, botname):
    uid = user.id
    custom = S("welcome", "")
    if custom:
        return custom.replace("{name}", user.first_name or ""), None, main_kb(uid, botname)
    return tr(uid, "welcome", name=esc(user.first_name or "")), HTML, main_kb(uid, botname)


