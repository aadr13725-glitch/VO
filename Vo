def detect(url):
    host = (urlparse(url).netloc or "").lower().split(":")[0]
    for key, doms in PLATS.items():
        if any(host == d or host.endswith("." + d) for d in doms):
            return key
    return "other"


def urls_from_message(m):
    out = []
    for txt, ents in ((m.text, m.entities), (m.caption, m.caption_entities)):
        if not txt: continue
        out += [u.rstrip(".,)،") for u in URL_RE.findall(txt)]
        for e in ents or []:
            if e.type == "text_link" and e.url: out.append(e.url)
    return list(dict.fromkeys(out))


