def register_user(user):
    is_new = one("SELECT 1 FROM users WHERE id=?", (user.id,)) is None
    if is_new:
        run("INSERT INTO users(id,name) VALUES(?,?)", (user.id, user.full_name))
    else:
        run("UPDATE users SET name=?, blocked=0 WHERE id=?", (user.full_name, user.id))
    return is_new


