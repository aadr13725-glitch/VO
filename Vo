# ---------------- الاشتراك الإجباري ----------------
_sub_cache = {}


_ch_warned = {}


async def missing_channels(bot, uid):
    if is_admin(uid): return []
    miss = []
    for ch in channel_list(True):
        if _sub_cache.get((uid, ch), 0) > time.time(): continue
        try:
            m = await bot.get_chat_member(ch, uid)
            ok = m.status in ("member", "administrator", "creator") or (m.status == "restricted" and m.is_member)
        except TelegramError as e:
            log.warning("تعذّر فحص القناة %s (تأكد أن البوت مشرف فيها): %s", ch, e)
            if flag("sub_notify", "1") and _ch_warned.get(ch, 0) < time.time():
                _ch_warned[ch] = time.time() + 3600
                asyncio.create_task(notify_admins(
                    bot, f"⚠️ تعذّر فحص القناة {esc(ch)}، تأكد أن البوت مشرف فيها.\n<code>{esc(str(e)[:150])}</code>",
                    parse_mode=HTML))
            continue
        if ok: _sub_cache[(uid, ch)] = time.time() + 120
        else: miss.append(ch)
    return miss


def sub_btn(text, style=None, **kw):
    """زر مع دعم نمط الألوان الجديد (إذا لم يدعمه تيليغرام يتجاهله بأمان)."""
    if style and flag("sub_style", "0"):
        kw["api_kwargs"] = {"style": style}
    return IB(text, **kw)


async def send_sub_prompt(bot, chat_id, uid, miss, rp=None):
    text = S("sub_msg", "") or tr(uid, "sub_needed")
    join = lambda ch: sub_btn(f"{tr(uid, 'b_join')} {ch}", style="primary", url=f"https://t.me/{ch.lstrip('@')}")
    verify = []
    if flag("sub_verify", "1"):
        label = tr(uid, "b_chk")
        if not flag("sub_icon_on", "1"): label = label.replace("✅ ", "")
        verify = [[sub_btn(label, style="success", callback_data="chk")]]
    if S("sub_display", "group") == "group":          # مجمّعة: رسالة واحدة بكل القنوات
        kb = [[join(ch)] for ch in miss] + verify
        await bot.send_message(chat_id, text, reply_markup=IM(kb), reply_parameters=rp)
        return
    for ch in miss:                                    # منفصلة: رسالة لكل قناة
        await bot.send_message(chat_id, f"📢 {ch}", reply_markup=IM([[join(ch)]]), reply_parameters=rp)
    await bot.send_message(chat_id, text, reply_markup=IM(verify) if verify else None, reply_parameters=rp)


