def stats_text():
    c = lambda sql: one(sql)["c"]
    users = c("SELECT COUNT(*) c FROM users")
    new = c("SELECT COUNT(*) c FROM users WHERE date(joined)=date('now')")
    banned = c("SELECT COUNT(*) c FROM users WHERE banned=1")
    blocked = c("SELECT COUNT(*) c FROM users WHERE blocked=1")
    active = c("SELECT COUNT(DISTINCT uid) c FROM dl_log WHERE date(ts)=date('now')")
    ok = c("SELECT COUNT(*) c FROM dl_log WHERE ok=1 AND date(ts)=date('now')")
    bad = c("SELECT COUNT(*) c FROM dl_log WHERE ok=0 AND date(ts)=date('now')")
    total = c("SELECT COUNT(*) c FROM dl_log WHERE ok=1")
    txt = (f"📊 <b>إحصائيات البوت</b>\n\n👥 المستخدمون: {users}\n🆕 جدد اليوم: {new}\n🔥 نشطون اليوم: {active}\n"
           f"🚫 محظورون من طرفك: {banned}\n🧱 حاظرو البوت: {blocked}\n\n"
           f"📥 تحميلات اليوم: {ok} ✅ | {bad} ❌\n📦 كل التحميلات: {total}\n")
    pl = rows("SELECT platform, COUNT(*) c FROM dl_log WHERE ok=1 AND date(ts)=date('now') GROUP BY platform ORDER BY c DESC")
    if pl: txt += "\n🌐 حسب المنصة اليوم:\n" + "\n".join(f"• {esc(p['platform'])}: {p['c']}" for p in pl)
    return txt


async def forward_to_admins(bot, m, user):
    """يعرض للمشرفين كل رسالة يرسلها مستخدم مع أزرار رد وحظر."""
    banned = is_banned(user.id)
    kb = IM([[IB("✉️ رد", callback_data=f"a:reply:{user.id}"),
              IB("♻️ فك الحظر" if banned else "🚫 حظر", callback_data=f"a:{'unbanq' if banned else 'banq'}:{user.id}")]])
    uname = f"@{user.username}" if user.username else "بدون يوزر"
    head = f"📨 <b>{esc(user.full_name)}</b> ({esc(uname)})\n🆔 <code>{user.id}</code>"
    for a in admin_ids():
        if a == user.id: continue
        try:
            if m.text:
                await bot.send_message(a, f"{head}\n\n💬 {esc(m.text[:1000])}", parse_mode=HTML,
                                       reply_markup=kb, disable_web_page_preview=True)
            else:
                await bot.send_message(a, head, parse_mode=HTML)
                await bot.copy_message(a, m.chat_id, m.message_id, reply_markup=kb)
        except TelegramError:
            pass


