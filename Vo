# ---------------- التحميل من تيليغرام ----------------
async def process_link(context, user, chat_id, reply_to, url, audio=False):
    bot, uid = context.bot, user.id
    rp = ReplyParameters(message_id=reply_to, allow_sending_without_reply=True) if reply_to else None

    async def reply(text, **kw):
        return await bot.send_message(chat_id, text, parse_mode=HTML, reply_parameters=rp, **kw)

    if is_banned(uid): return await reply(tr(uid, "banned"))
    if flag("maintenance") and not is_admin(uid): return await reply(tr(uid, "maint"))
    try:
        await asyncio.to_thread(validate_public_url, url)
    except (ValueError, OSError):
        return await reply(tr(uid, "err_url"))
    p0 = detect(url)
    if not flag(f"plat_{p0}", "1"):
        nm = T[get_lang(uid)]["plat"].get(p0) or ("هذا الموقع" if get_lang(uid) == "ar" else "this site")
        return await reply(tr(uid, "plat_off", p=nm))
    miss = await missing_channels(bot, uid)
    if miss: return await send_sub_prompt(bot, chat_id, uid, miss, rp)
    limit = daily_limit()
    if limit and not is_admin(uid) and today_count(uid) >= limit:
        return await reply(tr(uid, "err_limit", n=limit))
    if uid in busy: return await reply(tr(uid, "busy"))

    busy.add(uid)
    tmp = tempfile.mkdtemp(prefix="dl_")
    plat = detect(url)
    status = None
    try:
        status = await reply(tr(uid, "downloading"))
        await bot.send_chat_action(chat_id, ChatAction.UPLOAD_VIDEO)
        async with get_sem():
            res = await asyncio.wait_for(asyncio.to_thread(dl_any, url, tmp, audio, LIMIT_BYTES), timeout=600)
        try:
            await bot.edit_message_text(tr(uid, "uploading"), chat_id, status.message_id)
        except TelegramError:
            pass

        cap = f"{tr(uid, 'caption')} • <b>{esc(str(res['title'])[:90])}</b>\n🤖 @{bot.username}"
        kb = None
        if res["kind"] == "video":
            links = context.bot_data.setdefault("links", {})
            token = secrets.token_hex(4)
            links[token] = url
            while len(links) > 300: links.pop(next(iter(links)))
            kb = IM([[IB(tr(uid, "b_audio"), callback_data=f"aud:{token}")]])
        common = dict(parse_mode=HTML, reply_parameters=rp, read_timeout=300, write_timeout=300, connect_timeout=30)
        dur = int(res["duration"]) if res.get("duration") else None
        with open(res["path"], "rb") as fh:
            try:
                if res["kind"] == "video":
                    await bot.send_video(chat_id, fh, duration=dur,
                                         width=int(res["width"]) if res.get("width") else None,
                                         height=int(res["height"]) if res.get("height") else None,
                                         caption=cap, supports_streaming=True, reply_markup=kb, **common)
                elif res["kind"] == "audio":
                    await bot.send_audio(chat_id, fh, duration=dur, title=str(res["title"])[:60], caption=cap, **common)
                else:
                    await bot.send_photo(chat_id, fh, caption=cap, **common)
            except BadRequest:
                fh.seek(0)
                await bot.send_document(chat_id, fh, caption=cap, reply_markup=kb, **common)
        run("INSERT INTO dl_log(uid,platform,url,ok,size) VALUES(?,?,?,1,?)", (uid, plat, safe_url_label(url), res["size"]))
    except TooBig:
        await reply(tr(uid, "err_toobig", mb=MAX_MB))
        run("INSERT INTO dl_log(uid,platform,url,ok,err) VALUES(?,?,?,0,?)", (uid, plat, safe_url_label(url), "too big"))
    except Exception as e:
        err = str(e)
        safe_err = safe_error_text(err)
        log.warning("download failed [%s] %s: %s", plat, safe_url_label(url), safe_err)
        low = err.lower()
        private = any(k in low for k in ("login", "private", "cookies", "sign in", "confirm your age", "authentication"))
        try:
            await reply(tr(uid, "err_private" if private else "err_generic"))
        except TelegramError:
            pass
        run("INSERT INTO dl_log(uid,platform,url,ok,err) VALUES(?,?,?,0,?)",
            (uid, plat, safe_url_label(url), safe_err))
    finally:
        busy.discard(uid)
        shutil.rmtree(tmp, ignore_errors=True)
        if status:
            try: await bot.delete_message(chat_id, status.message_id)
            except TelegramError: pass


# ---------------- الأوامر ----------------
def timed(fn):
    """يسجّل كل تفاعل (للإحصائيات: الرسائل / الجلسات / متوسط الاستجابة)."""
    async def wrapper(update, context):
        t0 = time.perf_counter()
        try:
            return await fn(update, context)
        finally:
            try:
                u = update.effective_user
                if u: run("INSERT INTO activity(uid,ms) VALUES(?,?)", (u.id, int((time.perf_counter() - t0) * 1000)))
            except Exception:
                pass
    return wrapper


async def refresh_private_commands(bot, uid):
    if is_owner(uid):
        commands = [BotCommand("start", "القائمة الرئيسية"), BotCommand("help", "طريقة الاستخدام"),
                    BotCommand("admin", "لوحة الإدارة"),
                    BotCommand("owner", "إدارة المالك والمشرفين"), BotCommand("stats", "الإحصائيات"),
                    BotCommand("cancel", "إلغاء")]
    elif is_admin(uid):
        commands = [BotCommand("start", "القائمة الرئيسية"), BotCommand("help", "طريقة الاستخدام"),
                    BotCommand("admin", "لوحة الإدارة"), BotCommand("stats", "الإحصائيات"),
                    BotCommand("cancel", "إلغاء")]
    else:
        commands = [BotCommand("start", "القائمة الرئيسية / Menu"),
                    BotCommand("help", "طريقة الاستخدام / How to use"),
                    BotCommand("cancel", "إلغاء / Cancel")]
    try:
        await bot.set_my_commands(commands, scope=BotCommandScopeChat(uid))
    except TelegramError as e:
        log.warning("تعذّر ضبط قائمة الأوامر للمستخدم %s: %s", uid, str(e)[:200])


@timed
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    await refresh_private_commands(context.bot, user.id)
    if is_banned(user.id): return
    context.user_data.pop("state", None)
    if register_user(user) and flag("join_notify", "1"):
        context.application.create_task(notify_admins(
            context.bot, f"🆕 مستخدم جديد: <b>{esc(user.full_name)}</b> (<code>{user.id}</code>)", parse_mode=HTML))
    if flag("maintenance") and not is_admin(user.id):
        return await update.message.reply_text(tr(user.id, "maint"))
    miss = await missing_channels(context.bot, user.id)
    if miss: return await send_sub_prompt(context.bot, update.effective_chat.id, user.id, miss)
    text, parse, kb = welcome_payload(user, context.bot.username)
    await update.message.reply_text(text, parse_mode=parse, reply_markup=kb)


async def cmd_dl(update: Update, context: ContextTypes.DEFAULT_TYPE):
    m, user = update.effective_message, update.effective_user
    if not m or not user: return
    uid = user.id
    register_user(user)
    cmd = (m.text or "/d").split()[0].lstrip("/").split("@")[0].lower()
    urls = urls_from_message(m)
    if not urls and m.reply_to_message:
        urls = urls_from_message(m.reply_to_message)
    if not urls:
        return await m.reply_text(tr(uid, "usage_cmd"), parse_mode=HTML)
    await process_link(context, user, m.chat_id, m.message_id, urls[0], audio=(cmd == "a"))


