async def broadcast(bot, admin_id, chat_id, message_id, mode="copy"):
    ok = bad = 0
    for u in rows("SELECT id FROM users WHERE banned=0 AND blocked=0"):
        for attempt in (1, 2):
            try:
                if mode == "forward":
                    await bot.forward_message(u["id"], chat_id, message_id)
                else:
                    await bot.copy_message(u["id"], chat_id, message_id)
                ok += 1
                break
            except RetryAfter as e:
                await asyncio.sleep(e.retry_after + 1)
                if attempt == 2: bad += 1
            except Forbidden:
                run("UPDATE users SET blocked=1 WHERE id=?", (u["id"],))
                bad += 1
                break
            except TelegramError:
                bad += 1
                break
        await asyncio.sleep(0.05)
    await notify_admins(bot, f"📢 انتهت الإذاعة\n✅ نجح: {ok}\n❌ فشل: {bad}")


_titles = {}


async def ch_title(bot, ch):
    if ch not in _titles:
        try:
            _titles[ch] = (await bot.get_chat(ch)).title or ch
        except TelegramError:
            _titles[ch] = ch
    return _titles[ch]


